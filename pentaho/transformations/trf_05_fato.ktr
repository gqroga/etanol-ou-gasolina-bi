<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>trf_05_fato</name>
    <description>Carga da fato_coleta_preco: 1 linha = revenda x produto x data.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters/>
    <log/>
    <maxdate/>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>100000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies/>
    <partitionschemas/>
    <slaveservers/>
    <clusterschemas/>
    <created_user>-</created_user>
    <created_date>2026/10/16 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/16 00:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Lookups com cache total (dimensões cabem em memória).
Chave não encontrada -&gt; -1 ('Não informado'): nenhuma linha fica sem chave.
fl_outlier é marcado depois, no job (sql/04_outliers.sql).</note>
      <xloc>420</xloc><yloc>50</yloc><width>460</width><heigth>70</heigth>
      <fontname>Sans</fontname><fontsize>10</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred><fontcolorgreen>0</fontcolorgreen><fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred><backgroundcolorgreen>244</backgroundcolorgreen><backgroundcolorblue>205</backgroundcolorblue>
      <bordercolorred>100</bordercolorred><bordercolorgreen>100</bordercolorgreen><bordercolorblue>100</bordercolorblue>
      <drawshadow>N</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>dw_postgres</name>
    <server>${DW_HOST}</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>${DW_DB}</database>
    <port>${DW_PORT}</port>
    <username>${DW_USER}</username>
    <password>${DW_PASSWORD}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute><code>EXTRA_OPTION_POSTGRESQL.reWriteBatchedInserts</code><attribute>true</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>${DW_PORT}</attribute></attribute>
      <attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <order>
    <hop><from>stg.precos_tratado</from><to>Remove duplicatas do grão</to><enabled>Y</enabled></hop>
    <hop><from>Remove duplicatas do grão</from><to>sk_data</to><enabled>Y</enabled></hop>
    <hop><from>sk_data</from><to>sk_localidade</to><enabled>Y</enabled></hop>
    <hop><from>sk_localidade</from><to>sk_revenda</to><enabled>Y</enabled></hop>
    <hop><from>sk_revenda</from><to>sk_produto</to><enabled>Y</enabled></hop>
    <hop><from>sk_produto</from><to>sk_bandeira</to><enabled>Y</enabled></hop>
    <hop><from>sk_bandeira</from><to>Colunas da fato</to><enabled>Y</enabled></hop>
    <hop><from>Colunas da fato</from><to>dw.fato_coleta_preco</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>stg.precos_tratado</name>
    <type>TableInput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_postgres</connection>
    <sql>-- Ordenado pelo grão para o step 'Unique rows' remover duplicatas.
-- valor_venda desempata: se o mesmo posto tiver 2 preços no mesmo dia, fica sempre o menor (carga determinística)
SELECT cnpj, produto, data_coleta, uf_sigla, municipio, bandeira,
       valor_venda, valor_compra, arquivo_origem
FROM stg.precos_tratado
ORDER BY cnpj, produto, data_coleta, arquivo_origem, valor_venda</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>80</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Remove duplicatas do grão</name>
    <type>Unique</type>
    <description>Mesmo CNPJ + produto + data: mantém a primeira ocorrência (a de menor preço)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <count_rows>N</count_rows>
    <count_field/>
    <reject_duplicate_row>N</reject_duplicate_row>
    <error_description/>
    <fields>
      <field><name>cnpj</name><case_insensitive>N</case_insensitive></field>
      <field><name>produto</name><case_insensitive>N</case_insensitive></field>
      <field><name>data_coleta</name><case_insensitive>N</case_insensitive></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>250</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>sk_data</name>
    <type>DBLookup</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_postgres</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>dw</schema>
      <table>dim_data</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>data_coleta</name><field>data</field><condition>=</condition><name2/></key>
      <value><name>sk_data</name><rename>sk_data</rename><default>-1</default><type>Integer</type></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>420</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>sk_localidade</name>
    <type>DBLookup</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_postgres</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>dw</schema>
      <table>dim_localidade</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>uf_sigla</name><field>uf_sigla</field><condition>=</condition><name2/></key>
      <key><name>municipio</name><field>municipio</field><condition>=</condition><name2/></key>
      <value><name>sk_localidade</name><rename>sk_localidade</rename><default>-1</default><type>Integer</type></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>560</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>sk_revenda</name>
    <type>DBLookup</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_postgres</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>dw</schema>
      <table>dim_revenda</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>cnpj</name><field>cnpj</field><condition>=</condition><name2/></key>
      <value><name>sk_revenda</name><rename>sk_revenda</rename><default>-1</default><type>Integer</type></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>700</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>sk_produto</name>
    <type>DBLookup</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_postgres</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>dw</schema>
      <table>dim_produto</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>produto</name><field>produto</field><condition>=</condition><name2/></key>
      <value><name>sk_produto</name><rename>sk_produto</rename><default>-1</default><type>Integer</type></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>840</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>sk_bandeira</name>
    <type>DBLookup</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_postgres</connection>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema>dw</schema>
      <table>dim_bandeira</table>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>bandeira</name><field>bandeira</field><condition>=</condition><name2/></key>
      <value><name>sk_bandeira</name><rename>sk_bandeira</rename><default>-1</default><type>Integer</type></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>980</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Colunas da fato</name>
    <type>SelectValues</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><name>sk_data</name><rename></rename></field>
      <field><name>sk_localidade</name><rename></rename></field>
      <field><name>sk_revenda</name><rename></rename></field>
      <field><name>sk_produto</name><rename></rename></field>
      <field><name>sk_bandeira</name><rename></rename></field>
      <field><name>valor_venda</name><rename></rename></field>
      <field><name>valor_compra</name><rename></rename></field>
      <field><name>arquivo_origem</name><rename></rename></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>1120</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>dw.fato_coleta_preco</name>
    <type>TableOutput</type>
    <description>Full reload (truncate + insert)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_postgres</connection>
    <schema>dw</schema>
    <table>fato_coleta_preco</table>
    <commit>10000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields/>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>1260</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling/>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
