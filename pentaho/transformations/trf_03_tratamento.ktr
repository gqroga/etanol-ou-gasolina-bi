<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>trf_03_tratamento</name>
    <description>Aplica as regras de limpeza descobertas na EDA de qualidade.</description>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <directory>/</directory>
    <parameters/>
    <log/>
    <maxdate/>
    <size_rowset>10000</size_rowset>
    <sleep_time_empty>50</sleep_time_empty>
    <sleep_time_full>50</sleep_time_full>
    <unique_connections>N</unique_connections>
    <feedback_shown>Y</feedback_shown>
    <feedback_size>100000</feedback_size>
    <using_thread_priorities>Y</using_thread_priorities>
    <shared_objects_file/>
    <capture_step_performance>N</capture_step_performance>
    <step_performance_capturing_delay>1000</step_performance_capturing_delay>
    <step_performance_capturing_size_limit>100</step_performance_capturing_size_limit>
    <dependencies/>
    <partitionschemas/>
    <slaveservers/>
    <clusterschemas/>
    <created_user>-</created_user>
    <created_date>2026/10/16 00:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/16 00:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Regras vindas da EDA de qualidade (notebook, parte 1):
0. Linhas vazias (só ';') -&gt; descartadas
1. CNPJ com e sem máscara / espaço à esquerda -&gt; só dígitos
2. Unidade 'R$ / m3' e 'R$ / m³' -&gt; 'R$ / m³'
3. Bandeira: VIBRA ENERGIA -&gt; VIBRA, ALESAT -&gt; ALE
4. Preço com vírgula decimal -&gt; número; data dd/MM/yyyy -&gt; date
5. Texto: trim + maiúsculas; valor vazio -&gt; NULL</note>
      <xloc>80</xloc><yloc>20</yloc><width>460</width><heigth>130</heigth>
      <fontname>Sans</fontname><fontsize>10</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred><fontcolorgreen>0</fontcolorgreen><fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred><backgroundcolorgreen>244</backgroundcolorgreen><backgroundcolorblue>205</backgroundcolorblue>
      <bordercolorred>100</bordercolorred><bordercolorgreen>100</bordercolorgreen><bordercolorblue>100</bordercolorblue>
      <drawshadow>N</drawshadow>
    </notepad>
  </notepads>
  <connection>
    <name>dw_postgres</name>
    <server>${DW_HOST}</server>
    <type>POSTGRESQL</type>
    <access>Native</access>
    <database>${DW_DB}</database>
    <port>${DW_PORT}</port>
    <username>${DW_USER}</username>
    <password>${DW_PASSWORD}</password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute><code>EXTRA_OPTION_POSTGRESQL.reWriteBatchedInserts</code><attribute>true</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>${DW_PORT}</attribute></attribute>
      <attribute><code>PRESERVE_RESERVED_WORD_CASE</code><attribute>Y</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>SUPPORTS_TIMESTAMP_DATA_TYPE</code><attribute>Y</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>
  <order>
    <hop><from>stg.precos_bruto</from><to>Descarta linhas vazias</to><enabled>Y</enabled></hop>
    <hop><from>Descarta linhas vazias</from><to>Padroniza texto e CNPJ/CEP</to><enabled>Y</enabled></hop>
    <hop><from>Descarta linhas vazias</from><to>Linhas vazias (descartadas)</to><enabled>Y</enabled></hop>
    <hop><from>Padroniza texto e CNPJ/CEP</from><to>Unifica unidade e espaços</to><enabled>Y</enabled></hop>
    <hop><from>Unifica unidade e espaços</from><to>Unifica sinônimos de bandeira</to><enabled>Y</enabled></hop>
    <hop><from>Unifica sinônimos de bandeira</from><to>Tipagem e nomes</to><enabled>Y</enabled></hop>
    <hop><from>Tipagem e nomes</from><to>stg.precos_tratado</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>stg.precos_bruto</name>
    <type>TableInput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_postgres</connection>
    <sql>SELECT regiao_sigla, estado_sigla, municipio, revenda, cnpj_revenda, bairro, cep,
       produto, data_coleta, valor_venda, valor_compra, unidade_medida, bandeira, arquivo_origem
FROM stg.precos_bruto</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>80</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Descarta linhas vazias</name>
    <type>FilterRows</type>
    <description>ca-2025-01.csv traz 9.114 linhas só com ';'</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
<send_true_to>Padroniza texto e CNPJ/CEP</send_true_to>
<send_false_to>Linhas vazias (descartadas)</send_false_to>
    <compare>
<condition>
 <negated>N</negated>
 <conditions>
  <condition>
   <negated>N</negated>
   <leftvalue>cnpj_revenda</leftvalue>
   <function>IS NOT NULL</function>
   <rightvalue/>
  </condition>
  <condition>
   <negated>N</negated><operator>AND</operator>
   <leftvalue>produto</leftvalue>
   <function>IS NOT NULL</function>
   <rightvalue/>
  </condition>
 </conditions>
</condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>200</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Linhas vazias (descartadas)</name>
    <type>Dummy</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>

    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>200</xloc><yloc>340</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Padroniza texto e CNPJ/CEP</name>
    <type>StringOperations</type>
    <description>trim + maiúsculas; CNPJ e CEP só com dígitos</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field>
        <in_stream_name>regiao_sigla</in_stream_name><out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type><pad_char/><pad_len/>
        <init_cap>no</init_cap><mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>estado_sigla</in_stream_name><out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type><pad_char/><pad_len/>
        <init_cap>no</init_cap><mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>municipio</in_stream_name><out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type><pad_char/><pad_len/>
        <init_cap>no</init_cap><mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>revenda</in_stream_name><out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type><pad_char/><pad_len/>
        <init_cap>no</init_cap><mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>bairro</in_stream_name><out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type><pad_char/><pad_len/>
        <init_cap>no</init_cap><mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>produto</in_stream_name><out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type><pad_char/><pad_len/>
        <init_cap>no</init_cap><mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>unidade_medida</in_stream_name><out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type><pad_char/><pad_len/>
        <init_cap>no</init_cap><mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>bandeira</in_stream_name><out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <padding_type>none</padding_type><pad_char/><pad_len/>
        <init_cap>no</init_cap><mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>cnpj_revenda</in_stream_name><out_stream_name/>
        <trim_type>none</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type><pad_char/><pad_len/>
        <init_cap>no</init_cap><mask_xml>none</mask_xml>
        <digits>digits_only</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
      <field>
        <in_stream_name>cep</in_stream_name><out_stream_name/>
        <trim_type>none</trim_type>
        <lower_upper>none</lower_upper>
        <padding_type>none</padding_type><pad_char/><pad_len/>
        <init_cap>no</init_cap><mask_xml>none</mask_xml>
        <digits>digits_only</digits>
        <remove_special_characters>none</remove_special_characters>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>340</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Unifica unidade e espaços</name>
    <type>ReplaceString</type>
    <description>R$ / m3 -&gt; R$ / m³; espaços duplos -&gt; 1</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field>
        <in_stream_name>unidade_medida</in_stream_name><out_stream_name/>
        <use_regex>yes</use_regex>
        <replace_string>m3$</replace_string>
        <replace_by_string>m³</replace_by_string>
        <set_empty_string>N</set_empty_string><replace_field_by_string/>
        <whole_word>no</whole_word><case_sensitive>yes</case_sensitive>
      </field>
      <field>
        <in_stream_name>revenda</in_stream_name><out_stream_name/>
        <use_regex>yes</use_regex>
        <replace_string> {2,}</replace_string>
        <replace_by_string> </replace_by_string>
        <set_empty_string>N</set_empty_string><replace_field_by_string/>
        <whole_word>no</whole_word><case_sensitive>yes</case_sensitive>
      </field>
      <field>
        <in_stream_name>municipio</in_stream_name><out_stream_name/>
        <use_regex>yes</use_regex>
        <replace_string> {2,}</replace_string>
        <replace_by_string> </replace_by_string>
        <set_empty_string>N</set_empty_string><replace_field_by_string/>
        <whole_word>no</whole_word><case_sensitive>yes</case_sensitive>
      </field>
      <field>
        <in_stream_name>bairro</in_stream_name><out_stream_name/>
        <use_regex>yes</use_regex>
        <replace_string> {2,}</replace_string>
        <replace_by_string> </replace_by_string>
        <set_empty_string>N</set_empty_string><replace_field_by_string/>
        <whole_word>no</whole_word><case_sensitive>yes</case_sensitive>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>480</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Unifica sinônimos de bandeira</name>
    <type>ValueMapper</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <field_to_use>bandeira</field_to_use>
    <target_field></target_field>
    <non_match_default></non_match_default>
    <fields>
      <field><source_value>VIBRA ENERGIA</source_value><target_value>VIBRA</target_value></field>
      <field><source_value>ALESAT</source_value><target_value>ALE</target_value></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>620</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Tipagem e nomes</name>
    <type>SelectValues</type>
    <description>Texto -&gt; data (dd/MM/yyyy) e número (vírgula decimal)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><name>regiao_sigla</name><rename></rename></field>
      <field><name>estado_sigla</name><rename>uf_sigla</rename></field>
      <field><name>municipio</name><rename></rename></field>
      <field><name>revenda</name><rename>razao_social</rename></field>
      <field><name>cnpj_revenda</name><rename>cnpj</rename></field>
      <field><name>bairro</name><rename></rename></field>
      <field><name>cep</name><rename></rename></field>
      <field><name>produto</name><rename></rename></field>
      <field><name>data_coleta</name><rename></rename></field>
      <field><name>valor_venda</name><rename></rename></field>
      <field><name>valor_compra</name><rename></rename></field>
      <field><name>unidade_medida</name><rename></rename></field>
      <field><name>bandeira</name><rename></rename></field>
      <field><name>arquivo_origem</name><rename></rename></field>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>data_coleta</name><rename>data_coleta</rename><type>Date</type><length>-2</length><precision>-2</precision>
        <conversion_mask>dd/MM/yyyy</conversion_mask><date_format_lenient>false</date_format_lenient>
        <date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number>
        <encoding/><decimal_symbol></decimal_symbol><grouping_symbol></grouping_symbol>
        <currency_symbol/><storage_type/>
      </meta>
      <meta>
        <name>valor_venda</name><rename>valor_venda</rename><type>Number</type><length>-2</length><precision>-2</precision>
        <conversion_mask>#.###</conversion_mask><date_format_lenient>false</date_format_lenient>
        <date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number>
        <encoding/><decimal_symbol>,</decimal_symbol><grouping_symbol>.</grouping_symbol>
        <currency_symbol/><storage_type/>
      </meta>
      <meta>
        <name>valor_compra</name><rename>valor_compra</rename><type>Number</type><length>-2</length><precision>-2</precision>
        <conversion_mask>#.###</conversion_mask><date_format_lenient>false</date_format_lenient>
        <date_format_locale/><date_format_timezone/><lenient_string_to_number>false</lenient_string_to_number>
        <encoding/><decimal_symbol>,</decimal_symbol><grouping_symbol>.</grouping_symbol>
        <currency_symbol/><storage_type/>
      </meta>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>800</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>stg.precos_tratado</name>
    <type>TableOutput</type>
    <description></description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>dw_postgres</connection>
    <schema>stg</schema>
    <table>precos_tratado</table>
    <commit>10000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <fields/>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI><xloc>980</xloc><yloc>200</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling/>
  <slave-step-copy-partition-distribution/>
  <slave_transformation>N</slave_transformation>
  <attributes/>
</transformation>
